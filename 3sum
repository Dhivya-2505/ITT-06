class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        vector<vector<int>> result;
        int n = nums.size();
        
        // 1. Sort the array to use two pointers and handle duplicates
        sort(nums.begin(), nums.end());

        for (int i = 0; i < n; i++) {
            // 2. Skip duplicates for the first element
            if (i > 0 && nums[i] == nums[i - 1]) continue;

            // 3. Two-pointer search
            int left = i + 1;
            int right = n - 1;

            while (left < right) {
                int sum = nums[i] + nums[left] + nums[right];

                if (sum == 0) {
                    result.push_back({nums[i], nums[left], nums[right]});
                    
                    // 4. Skip duplicates for the second and third elements
                    while (left < right && nums[left] == nums[left + 1]) left++;
                    while (left < right && nums[right] == nums[right - 1]) right--;
                    
                    left++;
                    right--;
                } 
                else if (sum < 0) {
                    left++; // Sum too small, move left pointer right (increase sum)
                } 
                else {
                    right--; // Sum too big, move right pointer left (decrease sum)
                }
            }
        }
        return result;
    }
};
