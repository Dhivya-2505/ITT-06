#include <string>
using namespace std;

class Solution {
public:
    int strStr(string haystack, string needle) {
        int n = haystack.length();
        int m = needle.length();

        // Logic: If needle is longer than haystack, it's impossible to find a match
        if (m > n) return -1;

        // Slide the window over the haystack
        // We stop at (n - m) because there isn't enough space for the needle after that
        for (int i = 0; i <= n - m; i++) {
            
            // Check if the substring of haystack starting at 'i' matches 'needle'
            int j = 0;
            while (j < m && haystack[i + j] == needle[j]) {
                j++;
            }

            // If we successfully reached the end of the needle, we found the match
            if (j == m) {
                return i;
            }
        }

        // If the loop finishes without returning, no match was found
        return -1;
    }
};
