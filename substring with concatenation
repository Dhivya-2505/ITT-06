#include <vector>
#include <string>
#include <unordered_map>

using namespace std;

class Solution {
public:
    vector<int> findSubstring(string s, vector<string>& words) {
        vector<int> result;
        if (s.empty() || words.empty()) return result;

        int n = s.length();
        int numWords = words.size();
        int wordLen = words[0].length();
        int totalLen = numWords * wordLen;

        // 1. Build frequency map of the required words
        unordered_map<string, int> targetCounts;
        for (const string& w : words) targetCounts[w]++;

        // 2. Sliding window with different offsets (0 to wordLen - 1)
        for (int i = 0; i < wordLen; ++i) {
            int left = i, count = 0;
            unordered_map<string, int> windowCounts;

            for (int j = i; j <= n - wordLen; j += wordLen) {
                string word = s.substr(j, wordLen);

                if (targetCounts.count(word)) {
                    windowCounts[word]++;
                    count++;

                    // If we have more of 'word' than needed, slide left pointer
                    while (windowCounts[word] > targetCounts[word]) {
                        string leftWord = s.substr(left, wordLen);
                        windowCounts[leftWord]--;
                        count--;
                        left += wordLen;
                    }

                    // Success: window matches the concatenation
                    if (count == numWords) {
                        result.push_back(left);
                    }
                } else {
                    // Invalid word: reset the window entirely
                    windowCounts.clear();
                    count = 0;
                    left = j + wordLen;
                }
            }
        }

        return result;
    }
};
