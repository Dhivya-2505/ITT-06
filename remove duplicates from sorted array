class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        if (nums.empty()) return 0;
        
        int k = 1; // Index for the next unique element position
        
        for (int i = 1; i < nums.size(); i++) {
            // If the current element is different from the last unique one
            if (nums[i] != nums[k - 1]) {
                nums[k] = nums[i]; // Move it to the 'k' position
                k++;               // Increment the count of unique elements
            }
        }
        
        return k;
    }
};
