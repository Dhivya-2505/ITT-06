class Solution {
public:
    bool isPalindrome(int x) {
        // Step 1: Logic for Negative Numbers and Trailing Zeros
        // x < 0: Negative signs don't exist at the end (e.g., -121 != 121-)
        // x % 10 == 0: If it ends in 0, it must start with 0 (only possible for the number 0)
        if (x < 0 || (x % 10 == 0 && x != 0)) {
            return false;
        }

        long reversedNum = 0;
        int original = x;

        // Step 2: Reverse the number
        while (x > 0) {
            int lastDigit = x % 10;
            reversedNum = (reversedNum * 10) + lastDigit;
            x /= 10;
        }

        // Step 3: Check if original equals reversed
        return (long)original == reversedNum;
    }
};
